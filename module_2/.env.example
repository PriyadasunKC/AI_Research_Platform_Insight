# ─────────────────────────────────────────────────────────────────────────────
# Module 2 — Sinhala Historical KG Pipeline
# Environment variables — copy this file to .env and fill in values.
# NEVER commit the filled .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# OpenAI API key — https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-key-here

# OpenAI model (gpt-4o-mini = cheap & fast, gpt-4o = most capable)
OPENAI_MODEL=gpt-4o-mini

# Path to your trained XLM-RoBERTa NER model directory
# Must contain: config.json, pytorch_model.bin (or model.safetensors),
#               tokenizer_config.json, label mapping file
NER_MODEL_PATH=./models/xlmr_ner

# ─── Neo4j Graph Database ─────────────────────────────────────────────────────
# Download Neo4j Desktop: https://neo4j.com/download/
# Or run via Docker: docker run -p 7474:7474 -p 7687:7687 neo4j:latest
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# ─── MongoDB — Pipeline Run History ──────────────────────────────────────────
# Download: https://www.mongodb.com/try/download/community
# Or run via Docker: docker run -p 27017:27017 mongo:latest
MONGO_URI=mongodb://localhost:27017
MONGO_DB=sinhala_kg

# ─── Future: SinLLaMA / Aya-Expanse vLLM API (Module 3) ─────────────────────
# Uncomment when Module 3 model is ready.
# SINLLAMA_API_URL=http://module3-api/v1/completions
# SINLLAMA_MODEL_NAME=sinllama-historical

# ─── External Essay Accuracy API (api_server.py) — for other modules ────────
# Comma-separated key:name pairs, one per calling module/client, so every
# API request is traceable to who sent it. Generate a key with e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
ESSAY_API_KEYS=changeme-module3-key:Module3,changeme-other-key:OtherModule
